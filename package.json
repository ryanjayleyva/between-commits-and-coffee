{
  "name": "between-commits-and-coffee",
  "description": "Practical notes on full-stack development, Neovim, integrations, and automation, written between commits.",
  "author": "RJ Leyva <rjleyva@tuta.io>",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{astro,css,js,jsx,ts,tsx,json}\" \"*.{ts,mjs,json,jsonc,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,css,js,jsx,ts,tsx,json}\" \"*.{ts,mjs,json,jsonc,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "pnpm run build && wrangler deploy",
    "cf:dev": "pnpm run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "astro": "^7.2.0",
    "modern-normalize": "^3.0.1",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "wrangler": "^4.120.0"
  }
}
