{
  "name": "between-commits-and-coffee",
  "description": "Things I’ve learned building software, and things I’m still figuring out.",
  "author": "RJ Leyva <rjleyva@tuta.io>",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"{src,tests}/**/*.{astro,css,ts}\" \"*.{ts,json,jsonc,md}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{astro,css,ts}\" \"*.{ts,json,jsonc,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm run build && wrangler deploy",
    "cf:dev": "pnpm run build && wrangler dev",
    "cf:serve": "wrangler dev",
    "security": "osv-scanner scan source --lockfile=pnpm-lock.yaml && pnpm audit",
    "security:secrets": "gitleaks git --redact"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "astro": "7.4.4",
    "modern-normalize": "^3.0.1",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-astro": "^1.7.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.143.0"
  }
}
