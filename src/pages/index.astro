---
import Hero from '@/components/Hero/Hero.astro'
import Base from '@/layouts/base/Base.astro'
import { getPosts, toPostLinks } from '@/lib/content'
import { SITE } from '@/lib/site'

const posts = await getPosts()
const postLinks = toPostLinks(posts)
---

<Base title={SITE.siteName} ogImageAlt={SITE.siteName}>
  <Hero
    heading={SITE.siteName}
    subHeading="Things I’ve learned building software, and things I’m still figuring out."
    postLinks={postLinks}
    codebergUsername="rjl"
    timeZone={SITE.timeZone}
  />
</Base>
