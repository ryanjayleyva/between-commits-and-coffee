---
import Hero from '@/components/ui/Hero.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, toPostLinks } from '@/lib/content'
import { SITE } from '@/lib/site'

const posts = await getPosts()
const postLinks = toPostLinks(posts)
---

<BaseLayout title={SITE.siteName} ogImageAlt={SITE.siteName}>
  <Hero
    heading={SITE.siteName}
    subHeading="Notes on code, tools, workflows, and the rabbit holes in between."
    postLinks={postLinks}
    codebergUsername="rjl"
    timeZone={SITE.timeZone}
  />
</BaseLayout>
