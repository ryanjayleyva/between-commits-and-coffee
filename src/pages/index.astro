---
import Hero from '@/components/Hero/Hero.astro'
import Base from '@/layouts/base/Base.astro'
import { getPosts, toPostLinks } from '@/lib/content'
import { SITE } from '@/lib/site'

const posts = await getPosts()
const postLinks = toPostLinks(posts)
---

<Base title={SITE.siteName} ogImageAlt={SITE.siteName}>
  <Hero
    heading={SITE.siteName}
    subHeading="Thoughts, lessons, experiments, and discoveries from building software, figuring things out, and everything in between."
    postLinks={postLinks}
    githubUsername="ryanjayleyva"
    timeZone={SITE.timeZone}
  />
</Base>
