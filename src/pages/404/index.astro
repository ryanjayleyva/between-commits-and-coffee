---
import DetachedContent from '@/components/404/DetachedContent.astro'
import DetachedFooter from '@/components/404/DetachedFooter.astro'
import DetachedGraph from '@/components/404/DetachedGraph.astro'
import DetachedHead from '@/components/404/DetachedHead.astro'
import DetachedHeader from '@/components/404/DetachedHeader.astro'
import NotFoundLayout from '@/layouts/404Layout.astro'

const commitSuffix = Math.random().toString(16).slice(2, 9)
---

<NotFoundLayout
  title="Page Not Found"
  description="The requested page is not reachable from any branch in this repository."
>
  <div class="detached" data-detached>
    <DetachedHeader />

    <main class="detached__stage">
      <DetachedGraph />
      <DetachedHead />
      <DetachedContent commitSuffix={commitSuffix} />
    </main>

    <DetachedFooter commitSuffix={commitSuffix} />
  </div>
</NotFoundLayout>

<script>
  import '@/scripts/detached'
</script>

<style>
  .detached {
    --detached-easing: cubic-bezier(0.76, 0, 0.24, 1);
    --detached-padding: clamp(1.25rem, 4vw, 3rem);

    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    padding: var(--detached-padding);
    overflow: hidden;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-geist), system-ui, sans-serif;
  }

  .detached__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr auto 1fr;
    flex: 1;
    gap: 2rem;
    margin-top: clamp(1rem, 4vh, 3rem);
  }

  @media (max-width: 768px) {
    .detached {
      --detached-padding: clamp(1rem, 5vw, 1.5rem);
    }

    .detached__stage {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      gap: 1.5rem;
      margin-top: 2rem;
    }
  }

  @keyframes detached-fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes detached-line-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes detached-node-pop {
    from {
      transform: translateX(-50%) scale(0);
    }
    to {
      transform: translateX(-50%) scale(1);
    }
  }

  @keyframes detached-head-enter {
    from {
      opacity: 0;
      transform: translateX(-2rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes detached-head-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes detached-sha-reveal {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes detached-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
