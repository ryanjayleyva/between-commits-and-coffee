---
import DetachedContent from '@/features/not-found/DetachedContent.astro'
import DetachedFooter from '@/features/not-found/DetachedFooter.astro'
import DetachedGraph from '@/features/not-found/DetachedGraph.astro'
import DetachedHead from '@/features/not-found/DetachedHead.astro'
import DetachedHeader from '@/features/not-found/DetachedHeader.astro'
import NotFoundLayout from '@/layouts/404/404.astro'

const commitSuffix = Math.random().toString(16).slice(2, 9)
---

<NotFoundLayout
  title="Page Not Found"
  description="The requested page is not reachable from any branch in this repository."
>
  <div class="detached" data-detached>
    <DetachedHeader />

    <main class="detached__stage">
      <DetachedGraph />
      <DetachedHead />
      <DetachedContent commitSuffix={commitSuffix} />
    </main>

    <DetachedFooter commitSuffix={commitSuffix} />
  </div>
</NotFoundLayout>

<script>
  import '@/scripts/detached'
</script>
