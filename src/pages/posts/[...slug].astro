---
import { render } from 'astro:content'
import Breadcrumbs from '@/components/Breadcrumbs/Breadcrumbs.astro'
import Post from '@/components/Post/Post.astro'
import Base from '@/layouts/base/Base.astro'
import {
  getPostOgImagePath,
  getPosts,
  type Post as PostData,
} from '@/lib/content'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: PostData
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Base
  title={post.data.title}
  description={post.data.description}
  published={post.data.published}
  updated={post.data.updated}
  ogImage={new URL(getPostOgImagePath(post), Astro.site)}
  ogImageAlt={post.data.title}
>
  <Breadcrumbs title={post.data.title} parent={post.id.split('/')[0]} />
  <Post
    title={post.data.title}
    description={post.data.description}
    published={post.data.published}
    updated={post.data.updated}
  />
  <Content />
</Base>
