---
import './detached-graph.css'
---

<div class="detached__graph" aria-hidden="true">
  <div class="detached__timeline">
    <div class="detached__timeline-line"></div>
    <span class="detached__node detached__node--root"></span>
    <span class="detached__node detached__node--branch"></span>
    <span class="detached__node detached__node--tip"></span>
  </div>
  <div class="detached__branch detached__branch--main">main</div>
  <div class="detached__branch detached__branch--feature">feature</div>
</div>
