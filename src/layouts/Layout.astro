---
import { Font } from 'astro:assets'
import SkipLink from '@/components/ui/SkipLink.astro'
import { getAnalyticsToken, SITE } from '@/lib/site'
import '@/styles/index.css'

interface Props {
  title?: string
  description?: string
  published?: Date
  updated?: Date
}

const { title, description, published, updated } = Astro.props

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title
const pageDescription = description ?? SITE.description
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.url)
const analyticsToken = import.meta.env.PROD ? getAnalyticsToken() : undefined
const ogType = published ? 'article' : 'website'
const publishedIso = published?.toISOString()
const modifiedIso =
  published && updated && updated.valueOf() !== published.valueOf()
    ? updated.toISOString()
    : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#1c1917" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={ogType} />
    {
      publishedIso && (
        <meta property="article:published_time" content={publishedIso} />
      )
    }
    {
      modifiedIso && (
        <meta property="article:modified_time" content={modifiedIso} />
      )
    }
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <!-- TODO: add og:image, switch twitter:card to summary_large_image once a 1200x630 asset exists -->
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {
      analyticsToken && (
        <>
          {/* Cloudflare Web Analytics */}
          <script
            is:inline
            type="module"
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${analyticsToken}"}`}
          />
          {/* End Cloudflare Web Analytics */}
        </>
      )
    }
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-geist-mono" />
  </head>

  <body>
    <SkipLink />
    <main id="main-content" class="page">
      <slot />
    </main>
  </body>
</html>

<script>
  import '@/scripts/copy'
</script>

<style>
  .page {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
