---
import { ClientRouter } from 'astro:transitions'
import DocumentHead from '@/components/DocumentHead/DocumentHead.astro'
import Footer from '@/components/Footer/Footer.astro'
import Header from '@/components/Header/Header.astro'
import SkipLink from '@/components/SkipLink/SkipLink.astro'
import '@/styles/index.css'
import './base.css'

interface Props {
  title?: string
  description?: string
  published?: Date
  updated?: Date
  ogImage?: URL
  ogImageAlt?: string
}

const { title, description, published, updated, ogImage, ogImageAlt } =
  Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <DocumentHead
      title={title}
      description={description}
      published={published}
      updated={updated}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
    />
    <ClientRouter />
  </head>

  <body class="page-shell">
    <SkipLink />
    <Header />
    <main id="main-content" class="page-shell__main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import '@/scripts/copy'
</script>
