---
import DocumentHead from '@/components/DocumentHead/DocumentHead.astro'
import '@/styles/index.css'
import './404.css'

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <DocumentHead title={title} description={description} indexable={false} />
  </head>

  <body>
    <slot />
  </body>
</html>
