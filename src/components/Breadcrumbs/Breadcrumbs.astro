---
import { SITE } from '@/lib/site'
import './breadcrumbs.css'

interface Props {
  title: string
  parent?: string
  homeHref?: string
  homeLabel?: string
}

const { title, parent, homeHref = '/', homeLabel = SITE.siteName } = Astro.props
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list" role="list">
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href={homeHref}> {homeLabel} </a>
    </li>
    <li class="breadcrumbs__item" aria-hidden="true">
      <span class="breadcrumbs__separator">›</span>
    </li>
    <li class="breadcrumbs__item">
      <span class="breadcrumbs__static">{parent ?? 'posts'}</span>
    </li>
    <li class="breadcrumbs__item" aria-hidden="true">
      <span class="breadcrumbs__separator">›</span>
    </li>
    <li class="breadcrumbs__item breadcrumbs__item--current">
      <span class="breadcrumbs__current" title={title} aria-current="page">
        {title}
      </span>
    </li>
  </ol>
</nav>
