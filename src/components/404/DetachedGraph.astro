---

---

<div class="detached__graph" aria-hidden="true">
  <div class="detached__timeline">
    <div class="detached__timeline-line"></div>
    <span class="detached__node detached__node--root"></span>
    <span class="detached__node detached__node--branch"></span>
    <span class="detached__node detached__node--tip"></span>
  </div>
  <div class="detached__branch detached__branch--main">main</div>
  <div class="detached__branch detached__branch--feature">feature</div>
</div>

<style>
  .detached__graph {
    grid-column: 1;
    grid-row: 1 / -1;
    position: relative;
    justify-self: end;
    align-self: center;
    width: clamp(8rem, 22vw, 14rem);
    height: clamp(16rem, 45vh, 30rem);
  }

  .detached__timeline {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }

  .detached__timeline-line {
    position: absolute;
    inset: 0;
    background-color: color-mix(
      in srgb,
      var(--color-text-muted) 25%,
      transparent
    );
    transform-origin: top;
    animation: detached-line-grow 1.2s cubic-bezier(0.76, 0, 0.24, 1) 0.3s
      backwards;
  }

  .detached__node {
    position: absolute;
    left: 50%;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background-color: var(--color-text-muted);
    transform: translateX(-50%) scale(0);
    animation: detached-node-pop 0.5s cubic-bezier(0.76, 0, 0.24, 1) backwards;
  }

  .detached__node--root {
    top: 0;
    animation-delay: 0.8s;
  }

  .detached__node--branch {
    top: 40%;
    background-color: var(--color-warning);
    animation-delay: 1s;
  }

  .detached__node--tip {
    bottom: 0;
    background-color: var(--color-success);
    animation-delay: 1.2s;
  }

  .detached__branch {
    position: absolute;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: clamp(0.65rem, 1vw, 0.75rem);
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    opacity: 0;
    animation: detached-fade-in 0.6s cubic-bezier(0.76, 0, 0.24, 1) backwards;
  }

  .detached__branch--main {
    top: 2%;
    left: calc(50% + 1.25rem);
    animation-delay: 1.4s;
  }

  .detached__branch--feature {
    top: 38%;
    right: calc(50% + 1.25rem);
    animation-delay: 1.5s;
  }

  @media (max-width: 768px) {
    .detached__graph {
      grid-column: 1;
      grid-row: 1;
      justify-self: center;
      height: clamp(10rem, 30vh, 16rem);
      width: clamp(6rem, 20vw, 10rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detached__timeline-line,
    .detached__node,
    .detached__branch {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
