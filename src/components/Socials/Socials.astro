---
import RssLink from '@/components/RssLink/RssLink.astro'
import { SOCIAL_LINKS, type SocialLink } from '@/lib/site'
import './socials.css'

interface Props {
  links?: SocialLink[]
}

const { links = SOCIAL_LINKS } = Astro.props
---

<ul class="socials" role="list">
  {
    links.map(({ label, href }) => (
      <li class="socials__item">
        <a
          class="socials__link"
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${label} (Opens in new tab)`}
        >
          {label}
        </a>
      </li>
    ))
  }
  <li class="socials__item">
    <RssLink />
  </li>
</ul>
