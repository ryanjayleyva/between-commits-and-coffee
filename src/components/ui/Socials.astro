---
import { SOCIAL_LINKS, type SocialLink } from '@/lib/site'
import RssLink from './RssLink.astro'

interface Props {
  links?: SocialLink[]
}

const { links = SOCIAL_LINKS } = Astro.props
---

<ul class="socials" role="list">
  {
    links.map(({ label, href }) => (
      <li class="socials__item">
        <a
          class="socials__link"
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${label} (opens in new tab)`}
        >
          {label}
        </a>
      </li>
    ))
  }
  <li class="socials__item">
    <RssLink />
  </li>
</ul>

<style>
  .socials {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .socials__link {
    text-decoration: none;
  }

  .socials__link:hover,
  .socials__link:focus-visible {
    color: var(--color-link-hover);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    outline: 0;
  }
</style>
