---
import type { PostLink } from '@/lib/content'
import { SITE } from '@/lib/site'
import PostLinks from './PostLinks.astro'
import Socials from './Socials.astro'

interface Props {
  heading: string
  subHeading: string
  postLinks?: PostLink[]
  status?: string
}

const { heading, subHeading, postLinks } = Astro.props

const host = SITE.url?.replace(/^https?:\/\//, '') ?? ''
const status = Astro.props.status ?? `${host} is still in development`
---

<section class="hero" aria-labelledby="hero-heading">
  {
    status && (
      <p class="hero__status">
        <span class="hero__status-dot" aria-hidden="true" />
        {status}
      </p>
    )
  }
  <h1 class="hero__heading" id="hero-heading">
    {heading}
  </h1>
  <p class="hero__subheading">{subHeading}</p>
  <Socials />
  <PostLinks links={postLinks} />
</section>

<style>
  .hero {
    padding-block-start: 4rem;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: clamp(0.7rem, 1vw, 0.8rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-danger-muted);
  }

  .hero__status-dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: var(--color-danger-muted);
    animation: hero-pulse 2s ease-in-out infinite;
  }

  .hero__heading {
    margin-bottom: 0.5rem;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    color: var(--color-warning-muted);
  }

  .hero__subheading {
    color: var(--color-info-muted);
    margin-top: 0;
  }

  .hero :global(.socials) {
    margin-top: 2rem;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__status-dot {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
