---
import type { PostLink } from '@/lib/content'
import PostLinks from './PostLinks.astro'
import SiteStatus from './SiteStatus.astro'
import Socials from './Socials.astro'

interface Props {
  heading: string
  subHeading: string
  postLinks?: PostLink[]
  status?: string
}

const { heading, subHeading, postLinks, status } = Astro.props
---

<section class="hero" aria-labelledby="hero-heading">
  <SiteStatus status={status} />
  <h1 class="hero__heading" id="hero-heading">
    {heading}
  </h1>
  <p class="hero__subheading">{subHeading}</p>
  <Socials />
  <PostLinks links={postLinks} />
</section>

<style>
  .hero {
    padding-block-start: 4rem;
  }

  .hero__heading {
    margin-bottom: 0.5rem;
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    color: var(--color-warning-muted);
  }

  .hero__subheading {
    color: var(--color-info-muted);
    margin-top: 0;
  }

  .hero :global(.socials) {
    margin-top: 2rem;
  }
</style>
