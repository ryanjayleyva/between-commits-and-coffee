---
import {
  calculateLevels,
  generateRollingCalendar,
  getMonthLabels,
} from '@/features/contribution-graph/calendar'
import { fetchCodebergContributions } from '@/features/contribution-graph/codeberg'
import { formatISODateLong } from '@/features/contribution-graph/dates'
import type { CalendarWeek } from '@/features/contribution-graph/types'

interface Props {
  username: string
  timeZone: string
  endDate?: Date
}

const { username, timeZone, endDate = new Date() } = Astro.props

let weeks: CalendarWeek[] = calculateLevels(
  generateRollingCalendar(new Map(), { timeZone, endDate })
)
let error: string | null = null

try {
  const contributions = await fetchCodebergContributions(username, {
    timeZone,
    endDate,
  })
  const countsByDate = new Map(contributions.map(c => [c.date, c.count]))
  weeks = calculateLevels(
    generateRollingCalendar(countsByDate, { timeZone, endDate })
  )
} catch (e) {
  console.error('Failed to fetch Codeberg contributions:', e)
  error = 'Failed to load contributions'
}

const monthLabels = getMonthLabels(weeks)
const totalContributions = weeks.reduce(
  (sum, week) => sum + week.days.reduce((daySum, day) => daySum + day.count, 0),
  0
)

const weekdayLabels = [
  { label: 'Sun', show: false },
  { label: 'Mon', show: true },
  { label: 'Tue', show: false },
  { label: 'Wed', show: true },
  { label: 'Thu', show: false },
  { label: 'Fri', show: true },
  { label: 'Sat', show: false },
]

function tooltipText(count: number, date: string): string {
  const formatted = formatISODateLong(date)
  if (count === 0) {
    return `No contributions on ${formatted}`
  }
  return `${count} contribution${count === 1 ? '' : 's'} on ${formatted}`
}
---

<article
  class="contribution-graph"
  aria-label={`Contribution activity for ${username} in the last 12 months`}
>
  {
    error ? (
      <p class="contribution-graph__error" role="alert">
        Unable to load contribution activity. Please try again later.
      </p>
    ) : (
      <>
        <p class="contribution-graph__summary">
          {totalContributions.toLocaleString()} contribution
          {totalContributions === 1 ? '' : 's'} in the last 12 months
        </p>

        <div class="contribution-graph__scroll">
          <div
            class="contribution-graph__layout"
            style={`--week-count: ${weeks.length}`}
          >
            <div class="contribution-graph__month-labels" aria-hidden="true">
              {monthLabels.map(({ label, weekIndex }) => (
                <span style={`grid-column: ${weekIndex + 1}`}>{label}</span>
              ))}
            </div>

            <div class="contribution-graph__weekday-labels" aria-hidden="true">
              {weekdayLabels.map(({ label, show }) => (
                <span>{show ? label : ''}</span>
              ))}
            </div>

            <div
              class="contribution-graph__calendar"
              role="grid"
              aria-readonly="true"
            >
              {weeks.map((week, weekIndex) => (
                <div class="contribution-graph__week" role="row">
                  {week.days.map((day, dayIndex) => {
                    const tooltip = tooltipText(day.count, day.date)
                    return (
                      <button
                        type="button"
                        class="contribution-graph__cell"
                        data-level={day.level}
                        data-count={day.count}
                        data-date={day.date}
                        data-tooltip={tooltip}
                        aria-label={tooltip}
                        tabindex="0"
                        role="gridcell"
                        aria-rowindex={weekIndex + 1}
                        aria-colindex={dayIndex + 1}
                      />
                    )
                  })}
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="contribution-graph__legend">
          <span>Less</span>
          <div class="contribution-graph__legend-cells" aria-hidden="true">
            <span class="contribution-graph__cell" data-level="1" />
            <span class="contribution-graph__cell" data-level="2" />
            <span class="contribution-graph__cell" data-level="3" />
            <span class="contribution-graph__cell" data-level="4" />
            <span class="contribution-graph__cell" data-level="5" />
          </div>
          <span>More</span>
        </div>
      </>
    )
  }
</article>

<script>
  import { setupContributionGraphTooltips } from '@/features/contribution-graph/tooltip'

  document.addEventListener('astro:page-load', setupContributionGraphTooltips)
  setupContributionGraphTooltips()
</script>

<style>
  .contribution-graph {
    --cell-size: 0.5rem;
    --cell-gap: 0.125rem;

    margin-top: 2rem;
    padding: 1rem;
    border: 1px solid var(--color-surface-raised);
    border-radius: 0.5rem;
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 40rem) {
    .contribution-graph {
      --cell-size: 0.625rem;
      --cell-gap: 0.15rem;
    }
  }

  .contribution-graph__summary {
    margin: 0 0 0.75rem;
    font-family: var(--font-geist-mono), ui-monospace, monospace;
  }

  .contribution-graph__error {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--color-danger-muted);
    border-radius: 0.375rem;
    color: var(--color-danger);
    background-color: var(--color-surface);
  }

  .contribution-graph__scroll {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .contribution-graph__layout {
    --weekday-gutter: 1.5rem;

    display: grid;
    grid-template-columns: var(--weekday-gutter) max-content;
    grid-template-rows: auto auto;
    column-gap: 0.625rem;
    row-gap: var(--cell-gap);
    min-width: max-content;
  }

  .contribution-graph__month-labels {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(var(--week-count), var(--cell-size));
    column-gap: var(--cell-gap);
    align-items: end;
    height: 1rem;
  }

  .contribution-graph__month-labels span {
    justify-self: start;
    white-space: nowrap;
    line-height: 1;
    font-size: 0.875rem;
  }

  .contribution-graph__weekday-labels {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-rows: repeat(7, var(--cell-size));
    gap: var(--cell-gap);
    align-items: center;
    justify-items: end;
    line-height: 1;
    font-size: 0.875rem;
  }

  .contribution-graph__weekday-labels span {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .contribution-graph__calendar {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    flex-direction: row;
    gap: var(--cell-gap);
  }

  .contribution-graph__week {
    display: flex;
    flex-direction: column;
    gap: var(--cell-gap);
  }

  .contribution-graph__cell {
    position: relative;
    width: var(--cell-size);
    height: var(--cell-size);
    padding: 0;
    border: 0;
    border-radius: 0;
    background-color: var(--color-surface-raised);
    cursor: pointer;
    appearance: none;
  }

  .contribution-graph__cell[data-level='1'] {
    background-color: var(--color-surface-raised);
  }

  .contribution-graph__cell[data-level='2'] {
    background-color: var(--color-info-dark);
  }

  .contribution-graph__cell[data-level='3'] {
    background-color: var(--color-link);
  }

  .contribution-graph__cell[data-level='4'] {
    background-color: var(--color-info);
  }

  .contribution-graph__cell[data-level='5'] {
    background-color: var(--color-info-bright);
  }

  .contribution-graph__cell:hover,
  .contribution-graph__cell:focus-visible {
    outline: 2px solid var(--color-link-hover);
    outline-offset: 1px;
  }

  :global(#contribution-graph-tooltip) {
    position: fixed;
    z-index: 100;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    background-color: var(--color-surface-raised);
    color: var(--color-text);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.75rem;
    white-space: nowrap;
    pointer-events: none;
  }

  .contribution-graph__legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.75rem;
    width: 100%;
  }

  .contribution-graph__legend-cells {
    display: flex;
    gap: var(--cell-gap);
  }

  .contribution-graph__legend-cells .contribution-graph__cell {
    cursor: default;
  }
</style>
