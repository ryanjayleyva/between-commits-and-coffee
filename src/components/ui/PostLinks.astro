---
import type { PostLink } from '@/lib/content'
import { formatShortDate } from '@/lib/content'

interface Props {
  links?: PostLink[]
}

const { links = [] } = Astro.props
---

{
  links.length > 0 && (
    <div class="post-links">
      <p class="post-links__label">{new Date().getFullYear()}</p>
      <ul class="post-links__list" role="list">
        {links.map(({ title, href, date }) => (
          <li class="post-links__item">
            <span class="post-links__index">{formatShortDate(date)}</span>
            <a class="post-links__link" href={href}>
              {title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .post-links {
    margin-top: 3rem;
  }

  .post-links__label {
    margin: 1.5rem 0 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 1.25rem;
    letter-spacing: 0.1em;
  }

  .post-links__list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-links__item {
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: baseline;
    gap: 1.25rem;
  }

  .post-links__index {
    color: var(--color-text-muted);
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.85rem;
  }

  .post-links__link {
    text-decoration: none;
  }

  .post-links__link:hover,
  .post-links__link:focus-visible {
    color: var(--color-link-hover);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    outline: 0;
  }
</style>
