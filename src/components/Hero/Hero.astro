---
import PostLinks from '@/components/PostLinks/PostLinks.astro'
import Socials from '@/components/Socials/Socials.astro'
import GithubContributions from '@/features/contribution-graph/GithubContributions.astro'
import type { PostLink } from '@/lib/content'
import './hero.css'

interface Props {
  heading: string
  subHeading: string
  postLinks?: PostLink[]
  codebergUsername: string
  timeZone: string
}

const { heading, subHeading, postLinks, codebergUsername, timeZone } =
  Astro.props
---

<section class="hero" aria-labelledby="hero-heading">
  <h1 class="hero__heading" id="hero-heading">
    {heading}
  </h1>
  <p class="hero__subheading">{subHeading}</p>
  <Socials />
  <GithubContributions username={codebergUsername} timeZone={timeZone} />
  <PostLinks links={postLinks} />
</section>
