---
import { formatDate } from '@/lib/content'
import './post.css'

interface Props {
  title: string
  description?: string
  published: Date
  updated?: Date
  tags?: string[]
}

const { title, description, published, updated, tags = [] } = Astro.props

const showUpdated =
  updated !== undefined && updated.valueOf() !== published.valueOf()
---

<article class="post">
  <h1 class="post__title">{title}</h1>
  {description && <p class="post__description">{description}</p>}
  <p class="post__meta">
    Published {formatDate(published)}
    {
      showUpdated && (
        <>
          <br />
          Updated {formatDate(updated)}
        </>
      )
    }
  </p>
  {
    tags.length > 0 && (
      <ul class="post__tags" role="list">
        {tags.map(tag => (
          <li class="post__tag">
            <span class="post__tag-hash" aria-hidden="true">
              #
            </span>
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
