{
  "name": "bcc",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist",
    // TODO: enable once src/pages/404.astro exists
    // "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
